{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemon-champions-agents.local/hosted-demo/api.schema.json",
  "title": "Hosted demo HTTP contract (v0)",
  "description": "Contract for the API in design_draft_hosted_demo_2026-11-04.md section 3. Nothing here is implemented. Header for the session token is X-Session-Token (the draft said 'a header' and did not name it). Body cap 8192 bytes matches the draft's 'about 8 KB'. max_len is null: the 2026-11-04 fake-parser run passed 20019 characters through with no truncation. Score values are null in the sample transcripts; the score function is stream 1. provisional_slot is included because full_build_confirmation's build is not in team_draft (state.ProvisionalSlot). Parser failure is a 200 with reply_text, not the error envelope; the draft says it does not count a turn, and the graph today does (see the report).",
  "type": "object",
  "$defs": {
    "provider": {
      "type": "string",
      "enum": ["anthropic", "openai"]
    },
    "pending_kind": {
      "type": "string",
      "enum": [
        "candidate_selection",
        "full_build_confirmation",
        "completion_preference",
        "bootstrap_intake",
        "confirm_abandon_build",
        "spread_reallocation_question",
        "spread_target_question",
        "item_moveset_conflict_question"
      ],
      "description": "recommender/state.py PendingPresentation.kind"
    },
    "attr_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "locked"],
      "properties": {
        "value": {},
        "locked": {"type": "boolean"}
      }
    },
    "slot_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "locked", "fields"],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 6},
        "locked": {
          "type": "boolean",
          "description": "True only when role, species, ability, item, moveset, spread, and nature are all locked (state.all_locked)."
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "species", "ability", "item", "moveset", "spread", "nature"],
          "properties": {
            "role": {"$ref": "#/$defs/attr_view"},
            "species": {"$ref": "#/$defs/attr_view"},
            "ability": {"$ref": "#/$defs/attr_view"},
            "item": {"$ref": "#/$defs/attr_view"},
            "moveset": {"$ref": "#/$defs/attr_view"},
            "spread": {"$ref": "#/$defs/attr_view"},
            "nature": {"$ref": "#/$defs/attr_view"}
          }
        }
      }
    },
    "option_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "send_text"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "send_text": {
          "type": "string",
          "description": "Exact pending_input a button posts. Candidate rows use the 1-based ordinal ('1'), which classify_pending accepts. full_build_confirmation's accept button sends 'yes'. Build-option buttons send the option_id. completion_preference buttons send '1', '2', or '3'."
        }
      }
    },
    "score_half": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "fields"],
      "properties": {
        "members": {"type": ["integer", "null"], "minimum": 0, "maximum": 6},
        "fields": {"type": ["integer", "null"], "minimum": 0, "maximum": 24}
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locked_only", "include_unlocked"],
      "properties": {
        "locked_only": {"$ref": "#/$defs/score_half"},
        "include_unlocked": {
          "$ref": "#/$defs/score_half",
          "description": "Same comparison with lock flags ignored. Banner fuel from design section 6. Not implemented in this follow-up; samples use null."
        }
      }
    },
    "provisional_slot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["slot_index", "species", "ability", "item", "moves", "nature", "spread"],
      "properties": {
        "slot_index": {"type": "integer", "minimum": 1, "maximum": 6},
        "species": {"type": "string"},
        "ability": {"type": "string"},
        "item": {"type": "string"},
        "moves": {"type": "array", "items": {"type": "string"}, "minItems": 4, "maxItems": 4},
        "nature": {"type": "string"},
        "spread": {"type": "object"}
      }
    },
    "state_view": {
      "type": "object",
      "additionalProperties": false,
      "description": "Projection. Must not contain an API key, provider request, checkpoint, or the raw graph state.",
      "required": [
        "round",
        "turn",
        "max_len",
        "prompt_text",
        "notices",
        "pending_kind",
        "options",
        "slots",
        "provisional_slot",
        "score"
      ],
      "properties": {
        "round": {"type": "integer", "enum": [1, 2]},
        "turn": {"type": "integer", "minimum": 0},
        "max_len": {"type": ["integer", "null"]},
        "prompt_text": {"type": ["string", "null"]},
        "notices": {"type": "array", "items": {"type": "string"}},
        "pending_kind": {"oneOf": [{"$ref": "#/$defs/pending_kind"}, {"type": "null"}]},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option_view"}},
        "slots": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/slot_view"}
        },
        "provisional_slot": {"$ref": "#/$defs/provisional_slot"},
        "score": {"$ref": "#/$defs/score"}
      }
    },
    "error_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "counts_as_turn"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "in_flight",
                "stale_turn",
                "round_in_flight",
                "bad_request",
                "unsupported_media_type",
                "body_too_large",
                "unauthorized_key",
                "rate_limited",
                "provider_unavailable",
                "timeout",
                "session_not_found",
                "hint_off"
              ]
            },
            "message": {"type": "string"},
            "retryable": {"type": "boolean"},
            "counts_as_turn": {"type": "boolean", "const": false}
          }
        }
      }
    },
    "message_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reply_text", "state_view", "turn", "score"],
      "properties": {
        "reply_text": {"type": "string"},
        "state_view": {"$ref": "#/$defs/state_view"},
        "turn": {"type": "integer", "minimum": 0},
        "score": {"$ref": "#/$defs/score"}
      }
    }
  },
  "properties": {
    "POST /session": {
      "type": "object",
      "description": "201. Body {provider, model, api_key}. api_key is request-only and must not appear in the response, logs, or state_view.",
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "api_key"],
          "properties": {
            "provider": {"$ref": "#/$defs/provider"},
            "model": {"type": "string", "minLength": 1},
            "api_key": {"type": "string", "minLength": 1}
          }
        },
        "response_201": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_token", "state_view"],
          "properties": {
            "session_token": {"type": "string", "minLength": 32},
            "state_view": {"$ref": "#/$defs/state_view"}
          }
        }
      }
    },
    "POST /session/{token}/message": {
      "type": "object",
      "description": "200 message_response. 409 in_flight or stale_turn when expected_turn does not match state_view.turn or another message is running. Neither 409 counts a turn.",
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "expected_turn"],
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 8192},
            "expected_turn": {"type": "integer", "minimum": 0}
          }
        },
        "response_200": {"$ref": "#/$defs/message_response"},
        "response_409": {"$ref": "#/$defs/error_envelope"}
      }
    },
    "POST /session/{token}/key": {
      "type": "object",
      "description": "200. Replaces parsers. Does not change turn.",
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api_key"],
          "properties": {"api_key": {"type": "string", "minLength": 1}}
        },
        "response_200": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state_view"],
          "properties": {"state_view": {"$ref": "#/$defs/state_view"}}
        }
      }
    },
    "POST /session/{token}/round": {
      "type": "object",
      "description": "200. Fresh thread, same target, round 2, turn 0. 409 round_in_flight while a message is running.",
      "properties": {
        "request": {"type": "object", "additionalProperties": false, "maxProperties": 0},
        "response_200": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state_view"],
          "properties": {"state_view": {"$ref": "#/$defs/state_view"}}
        },
        "response_409": {"$ref": "#/$defs/error_envelope"}
      }
    },
    "POST /session/{token}/hint": {
      "type": "object",
      "description": "200 in round 1. 409 hint_off in round 2. Does not count a turn.",
      "properties": {
        "request": {"type": "object", "additionalProperties": false, "maxProperties": 0},
        "response_200": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hint_text", "state_view"],
          "properties": {
            "hint_text": {"type": "string"},
            "state_view": {"$ref": "#/$defs/state_view"}
          }
        },
        "response_409": {"$ref": "#/$defs/error_envelope"}
      }
    },
    "DELETE /session/{token}": {
      "type": "object",
      "description": "204 empty body. Drops parsers and the key.",
      "properties": {"response_204": {"type": "null"}}
    },
    "status": {
      "description": "400 bad_request, 401 unauthorized_key, 404 session_not_found, 409 in_flight|stale_turn|round_in_flight|hint_off, 413 body_too_large, 415 unsupported_media_type, 429 rate_limited, 503 provider_unavailable, 504 timeout. All of these use error_envelope and counts_as_turn false.",
      "type": "object"
    }
  }
}
